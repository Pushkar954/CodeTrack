# ============================================
# GoalForge AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files or actual secrets.

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/goalforge-ai
MONGO_URI_TEST=mongodb://localhost:27017/goalforge-ai-test

# Clerk Authentication
# CLERK_SECRET_KEY is server-side only. Never expose to the browser.
# Get from: Clerk Dashboard → API Keys → Secret Key
CLERK_SECRET_KEY=

# CLERK_PUBLISHABLE_KEY is client-side safe. Used by the frontend ClerkProvider.
# Get from: Clerk Dashboard → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=

# AI Provider (Phase 2)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Logging
LOG_LEVEL=development
LOG_FORMAT=json

# App
APP_VERSION=1.0.0
